{
  "manifest_version": 3,
  "name": "Zone & Locale Switcher",
  "version": "1.6.3",
  "description": "Minimalist timezone, locale, and speech voices switcher with Cloudflare-synced GeoIP, independent RU! leak guard, V8-stealth JS, and Zero-JS OOPIF/Worker CDP mode.",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "tabs",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Zone & Locale Switcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
